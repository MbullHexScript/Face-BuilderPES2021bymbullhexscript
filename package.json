{
  "name": "pes-2021-face-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "test": "playwright test",
    "format": "prettier --write src tests docs README.md *.json *.ts index.html",
    "format:check": "prettier --check src tests docs README.md *.json *.ts index.html"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
